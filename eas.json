{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    }
  }
}